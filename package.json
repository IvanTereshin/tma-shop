{
  "name": "tma-shop",
  "version": "0.1.0",
  "private": true,
  "description": "Universal e-commerce Telegram Mini App store (React storefront + Hono/Postgres API).",
  "license": "MIT",
  "author": "Ivan Tereshin <i.s.tereshin1992@gmail.com>",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "dev:api": "npm run dev --workspace apps/api",
    "dev:miniapp": "npm run dev --workspace apps/miniapp"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/node": "^22.10.0",
    "eslint": "^9.18.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.61.1"
  }
}
