# --- tma-shop API configuration ---

# HTTP port the API listens on
PORT=3000

# Postgres connection string
DATABASE_URL=postgres://tma:tma@localhost:5432/tma_shop

# Telegram bot token (from @BotFather). Used to validate Mini App initData
# and to call the Bot API for Stars invoices/webhooks. NEVER commit a real value.
BOT_TOKEN=123456:ABC-DEF_your_bot_token_here

# Secret used to sign session JWTs (any long random string)
JWT_SECRET=change-me-to-a-long-random-secret

# Session lifetime in seconds (default 1h)
JWT_TTL_SECONDS=3600

# Reject initData older than this many seconds (replay protection)
INITDATA_MAX_AGE_SECONDS=86400

# Comma-separated Telegram user ids granted the admin role
ADMIN_TELEGRAM_IDS=

# Secret token configured on the Telegram webhook (X-Telegram-Bot-Api-Secret-Token)
TELEGRAM_WEBHOOK_SECRET=change-me-webhook-secret

# Active shop id (uuid). Set after seeding; the seed script prints it.
SHOP_ID=

# CORS: allowed Mini App origin(s), comma-separated. Use * for local dev.
CORS_ORIGIN=*
